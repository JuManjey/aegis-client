        <!-- HCE-сервис для обмена PSK по NFC при касании (§6.2/P4). Отдаёт
             полезную нагрузку PSK только когда пользователь явно открыл экран
             показа ключа (см. PskNfcPayloadHolder). Работает локально, без сети. -->
        <service
            android:name=".nfc.PskHostApduService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/psk_apduservice" />
        </service>

        <!-- Фоновый приём сообщений через Tor (§14.5/§7.6): без FCM, поэтому
             держим процесс живым foreground-сервисом. Объявлены ОБА типа, а
             рантайм выбирает один (MessageSyncService.foregroundType):
               * API 34+ → specialUse: единственный тип без лимита времени;
               * API 29..33 → dataSync: лимитов там ещё нет, тип точнее по смыслу.
             Не экспортируется (запускается только самим приложением). -->
        <service
            android:name=".notifications.MessageSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <!-- Обоснование specialUse (требование Android 14+ и ревью Google Play).
                 AEGIS сознательно не использует FCM/push: любой push раскрыл бы
                 серверу и Google факт и время доставки (§7.6, zero-trust). Единственный
                 способ получать сообщения и ЗВОНКИ — непрерывный long-poll поверх Tor,
                 который обязан жить всё время, пока аккаунт разблокирован. Ни один
                 типизированный FGS этот сценарий не описывает, а dataSync ограничен
                 по времени и делает мессенджер глухим после исчерпания бюджета. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Непрерывный приём сообщений и звонков через Tor без push-сервисов (FCM не используется по требованиям приватности)" />
        </service>

        <!-- Медиазвонок: удерживает право на микрофон/камеру, пока идёт WebRTC. -->
        <service
            android:name=".notifications.CallMediaService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <!-- Действие «Отклонить» из уведомления о входящем звонке (§14.5): сброс
             в фоне, без вывода приложения. Не экспортируется — триггерится только
             PendingIntent'ами самого приложения. -->
        <receiver
            android:name=".notifications.CallActionReceiver"
            android:exported="false" />

        <!-- Временный доступ системной камеры к приватному кэш-файлу для съёмки
             вложения (§14.4, follow-up). Не экспортируется; доступ выдаётся только
             через grantUriPermissions на конкретный Uri. Снятый JPEG затирается
             после прочтения в память (CameraCapture.shred, §6.3/§7.4). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
